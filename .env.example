# Application Settings
PROJECT_NAME="SecureCare Healthcare Management System"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./securecare.db"

# Security & JWT Configuration
# Generate a secure 32+ byte key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="replace_this_with_a_very_secure_random_secret_key_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS Configuration (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]

# Jira Cloud Integration Configuration
JIRA_BASE_URL="https://sakec-team-bcq481n1.atlassian.net"
JIRA_EMAIL="your-atlassian-account-email@example.com"
JIRA_API_TOKEN="your-atlassian-api-token"
JIRA_PROJECT_KEY="SCR"

