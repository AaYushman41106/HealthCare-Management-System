# Application Settings
PROJECT_NAME="SecureCare Healthcare Management System"
VERSION="1.0.0-sprint1"
API_V1_STR="/api"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./securecare.db"

# Security & JWT Configuration
# Generate a secure 32+ byte key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="replace_this_with_a_very_secure_random_secret_key_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
